# URL of deployed Cloudflare Worker (see cloudflare-worker/) — also serves the revision AI endpoint
VITE_SYNC_API_URL=https://esat-sync-worker.your-name.workers.dev

# Public VAPID key for daily practice reminders (web push). Must be the same key
# set as the worker's VAPID_PUBLIC_KEY secret. base64url, 65-byte uncompressed
# P-256 point. See README "Push reminders" for how to generate a VAPID key pair.
VITE_VAPID_PUBLIC_KEY=
